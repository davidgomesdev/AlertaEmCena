{
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/github",
      {
        "assets": [
          { "path": "artifacts/alertaemcena-*" },
          { "path": "artifacts/backfill_reviews-*" },
          { "path": "artifacts/vote_summary-*" }
        ]
      }
    ]
  ]
}
